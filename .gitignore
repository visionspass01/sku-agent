# 本地打包/备份产物（部署时会在仓库外或仓库内生成的临时文件）
*.tar.gz
*.bak
*.old-*
backup-*

# 部署期生成的 TLS 证书（自签兜底证书 / 真实证书私钥都不要入库）
docker/certs/*
!docker/certs/.gitkeep
# 由 deploy.env.example 复制出来的真实部署变量（含密码）
docker/deploy.env

docs/myself/
data/eval/image_fixtures/*.png
!data/eval/image_fixtures/.gitkeep

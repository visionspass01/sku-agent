# ============ 必填 ============
# DeepSeek 官方 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-请替换为你的Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 登录 Token 签名密钥（务必改成随机值：openssl rand -hex 32）
# 仍为公开默认值时，应用启动打 WARNING，并在 /api/health.security 标记 secret_is_default=true
AUTH_SECRET=请替换为随机字符串

# 数据中台内部调用令牌（Agent ↔ 中台；务必改成随机值）
# 仍为默认值时会标记 platform_token_is_default=true
PLATFORM_INTERNAL_TOKEN=请替换为随机字符串

# ============ 数据库（compose 默认 MySQL） ============
# 改密码后若 data/mysql 卷已初始化，需要同时改库内用户或清卷重建
# MYSQL_ROOT_PASSWORD=请替换为随机值
# MYSQL_USER=sku
# MYSQL_PASSWORD=请替换为随机值
# MYSQL_DATABASE=sku_demo
# 中台库名（initdb 脚本按它建库，并授权给 MYSQL_USER）
# PLATFORM_MYSQL_DATABASE=platform

# ============ 检索栈（compose 默认 Qdrant + 腾讯 embedding） ============
# VECTOR_STORE=qdrant
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=kb_chunks
# EMBEDDING_BACKEND=tencent
# 未配置 Key 时自动降级为哈希向量（512 维，集合名随之变成 kb_chunks_512，检索仍走 Qdrant）
TENCENT_EMBEDDING_API_KEY=
TENCENT_EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
TENCENT_EMBEDDING_MODEL=kinfra-text-embedding-0.6b
# 零依赖写法（不用向量库 / 不用外部 embedding）：
# VECTOR_STORE=memory
# EMBEDDING_BACKEND=hash

# ============ 缓存 / 队列（可选） ============
# 默认不启动 Redis 容器，应用走进程内 fakeredis；
# 启用方式：设 REDIS_URL + 带 --profile redis 启动 compose
# REDIS_URL=redis://redis:6379/0

# ============ 多 Agent 治理（可选） ============
# PLATFORM_API_KEYS={"bi-agent":{"key":"k-xxxx","scopes":["read"],"departments":["女装"],"rate_limit":120}}

# ============ 演示与定时 ============
# 定时巡检（Demo 默认关闭）：开启后每小时 + 每日 09:00 会真实调用 LLM 巡检，
# 即使无人访问也会持续消耗 token。只演示手动全量巡检时保持 false。
SCHEDULER_ENABLED=false
# AUTH_TOKEN_TTL_HOURS=8

# ============ LLM（必填） ============
# DeepSeek 官方 API Key，申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认 deepseek-flash；也可改为 deepseek-v4-pro（更强但更慢）
LLM_MODEL=deepseek-flash
# deepseek-flash 为推理模型，关闭思维链可显著降低延迟（默认开启）
LLM_DISABLE_THINKING=true

# ============ 存储（默认本地 SQLite + fakeredis，零依赖启动） ============
# 切换 MySQL：mysql+pymysql://user:pass@127.0.0.1:3306/sku_demo?charset=utf8mb4
# DATABASE_URL=sqlite:///./data/sku_demo.db
# 配置真实 Redis 后自动使用真实实例；留空使用进程内 fakeredis
# REDIS_URL=redis://127.0.0.1:6379/0
# 中台库（与 Agent 库分开）：切 MySQL 时同步配置，否则中台仍是 SQLite
# PLATFORM_DB_URL=mysql+pymysql://sku:pass@127.0.0.1:3306/platform?charset=utf8mb4
# Docker compose 部署时 MySQL 容器密码（compose 读取同名变量）
# MYSQL_ROOT_PASSWORD=请替换为随机值
# MYSQL_USER=sku
# MYSQL_PASSWORD=请替换为随机值

# ============ MCP 传输 ============
# memory（默认，进程内 MCP JSON-RPC，受限环境可用）
# stdio（真实 MCP 子进程协议，常规本地环境推荐）
# direct（进程内函数直调，仅用于测试）
# MCP_TRANSPORT=memory

# ============ 演示数据规模 ============
# SEED=42
# SEED_DAYS=30

# ============ 定时任务（Demo 默认关闭：开启后会真实调用 LLM 巡检） ============
# SCHEDULER_ENABLED=false
# SCHEDULER_HOURLY_LIMIT=5
# SCHEDULER_DAILY_LIMIT=50
# ============ 认证（演示账号固定，生产请接企业统一登录） ============
# Token 签名密钥，生产环境务必替换为随机值
# AUTH_SECRET=change-me-demo-secret
# 登录 Token 有效期（小时）
# AUTH_TOKEN_TTL_HOURS=8
# ============ 数据中台（Agent 通过 REST 调用） ============
# PLATFORM_API_URL=http://127.0.0.1:8001
# PLATFORM_INTERNAL_TOKEN=demo-internal-token
# 高危补货人工确认阈值（数量 / 金额）
# PLATFORM_REPLENISH_QTY_THRESHOLD=200
# PLATFORM_REPLENISH_AMOUNT_THRESHOLD=50000

# ============ 四层记忆（L0/L1/L2/L3，默认值即可演示） ============
# L0：单次工具返回内联行数上限，超过只回 summary + artifact_path
# MEMORY_MAX_INLINE_ROWS=50
# L1：历史消息数 / token 超过阈值时压缩成 <analysis-facts> 事实卡
# MEMORY_FACTS_TRIGGER_MESSAGES=12
# MEMORY_FACTS_TRIGGER_TOKENS=4000
# 事实卡默认规则抽取（可复现）；置 true 才让 LLM 归纳
# MEMORY_FACTS_USE_LLM=false
# L0 明细与 L3 档案目录（默认 data/artifacts、data/analyses，随 data 卷持久化）
# ARTIFACTS_DIR=
# ANALYSES_DIR=

# ============ 检索栈（可选：向量库 + Embedding；不配则保持内存 + 哈希向量） ============
# vector_store：memory（默认，进程内 numpy 余弦） / qdrant（外部向量库）
# VECTOR_STORE=qdrant
# QDRANT_URL=http://qdrant:6333   （本地无 Docker 可用 QDRANT_URL=local 走 qdrant 本地模式）
# QDRANT_COLLECTION=kb_chunks      （实际集合名会带维度后缀，如 kb_chunks_1024）
# EMBEDDING_BACKEND=hash          （hash：本地 512 维哈希；tencent：腾讯云 TokenHub）
# 腾讯云 TokenHub（OpenAI 兼容）：https://cloud.tencent.com/document/product/1823/133515
# TENCENT_EMBEDDING_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# TENCENT_EMBEDDING_BASE_URL=https://tokenhub.tencentmaas.com/v1
# TENCENT_EMBEDDING_MODEL=kinfra-text-embedding-0.6b   （0.6b=1024 维 / 4b=2560 维）
# EMBEDDING_TIMEOUT_SECONDS=8
# EMBEDDING_MAX_RETRIES=2

# ============ 查询理解与规划（query_plan） ============
# 对话前生成结构化查询计划（确定性解析，成本≈0）
# QUERY_PLAN_ENABLED=true
# 生成式整句改写默认关闭：只做结构化计划，永不替换用户原句
# QUERY_REWRITE_LLM=false
# 置信度低于该值时最多追问一次
# QUERY_PLAN_CONFIDENCE_THRESHOLD=0.7
# 口径版本（写入 plan / 分析档案，用于结论可复现）
# METRIC_VERSION=2026Q1

# ============ 出口溯源校验（grounding） ============
# 答案里的带单位数字必须能追溯到本轮 result_id；不通过先让模型重写一次，仍不达标则标记 degraded
# GROUNDING_ENABLED=true

# ============ MCP 连接池 + 熔断 ============
# 每个 server 的会话数（>1 时同一 server 的并行取数不再排队；bench: scripts/bench_mcp.py）
# MCP_POOL_SIZE=2
# 同一 server 连续失败 N 次后熔断，窗口内直接快速失败（避免每次请求都先等超时再重试）
# MCP_BREAKER_THRESHOLD=3
# MCP_BREAKER_RESET_SECONDS=60
# MCP_CALL_TIMEOUT=30
# MCP_MAX_RETRIES=2

# ============ 登录限流（防爆破） ============
# 同一「账号+IP」在窗口内失败达到上限后返回 429（带 Retry-After），成功登录清零
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_SECONDS=60

# ============ 会话检查点（多轮追问 / 巡检线程） ============
# sqlite（默认，随 data 卷持久化，重启后追问仍可续）/ redis（多实例共享，需装 langgraph-checkpoint-redis）
# CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_PATH=
# 线程数上限：超过后按最近活跃时间淘汰，避免 checkpointer 无限增长
# CHECKPOINT_MAX_THREADS=200

# ============ 对话限流 / 并发 / 读写分离 ============
# 每用户每分钟对话轮次上限（超过返回 429 + Retry-After）
# CHAT_RATE_LIMIT_PER_MINUTE=20
# 进程内同时进行的对话轮次上限（超出排队，防止把上游 LLM 打成 429）
# CHAT_MAX_CONCURRENCY=4
# 写工具白名单（JSON 数组）：建补货草稿单 / 售后工单 / 沉淀档案只对这些角色开放，admin 始终允许
# WRITE_TOOLS_ROLES=["admin"]
# 单轮成功工具调用上限（工具循环守护）：超了立即中止本轮并提示重试（manifest 的 max_tool_calls 优先）
# CHAT_TOOL_CALL_BUDGET=15
# 单轮硬超时 / 重试预算：预算用尽即上抛，避免一轮占住并发槽十几分钟
# CHAT_TURN_TIMEOUT_SECONDS=300
# CHAT_RETRY_BUDGET_SECONDS=90
# 巡检单源采集超时（竞品/知识库失败降级继续；ERP 失败判本轮 failed）
# INSPECT_COLLECT_TIMEOUT_SECONDS=45

# ============ OpenTelemetry（可选，默认关闭）============
# 标准 OTLP endpoint：配了才导出 span（Langfuse / Jaeger / Tempo 都吃 OTLP）；
# 未安装 SDK 时自动跳过（pip install opentelemetry-sdk opentelemetry-exporter-otlp-proto-http）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=sku-agent
